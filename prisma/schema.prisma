generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TableStatus {
  IDLE
  PLAYING
  FINISHED
}

enum ConnectionStatus {
  ONLINE
  OFFLINE
}

enum GameStatus {
  ACTIVE
  FINISHED
}

enum ResultSource {
  MANUAL
  IMAGE_RECOGNITION
}

enum GameCategory {
  REGULAR
  TOURNAMENT
}

enum UserRole {
  SUPER_ADMIN
  STORE_ADMIN
  PLAYER
}

model Store {
  id               String         @id @default(cuid())
  name             String
  storeCode        String         @unique
  startingPoint    Int            @default(25000)
  returnPoint      Int            @default(30000)
  firstPlaceBonus  Int            @default(20)
  secondPlaceBonus Int            @default(10)
  thirdPlaceBonus  Int            @default(-10)
  fourthPlaceBonus Int            @default(-20)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tables           MahjongTable[]
  players          Player[]
  games            Game[]
  users            AppUser[]
  tournaments      Tournament[]
}

model MahjongTable {
  id                  String           @id @default(cuid())
  storeId             String
  tableNumber         Int
  deviceId            String           @unique
  status              TableStatus      @default(IDLE)
  connectionStatus    ConnectionStatus @default(OFFLINE)
  defaultCategory     GameCategory     @default(REGULAR)
  currentTournamentId String?
  lastSeenAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  store               Store            @relation(fields: [storeId], references: [id])
  currentTournament   Tournament?      @relation(fields: [currentTournamentId], references: [id])
  games               Game[]
  pointSnapshots      PointSnapshot[]

  @@unique([storeId, tableNumber])
  @@index([storeId, status])
  @@index([currentTournamentId])
  @@map("tables")
}

model Player {
  id               String       @id @default(cuid())
  storeId          String
  name             String
  managementNumber String?      @unique
  isCheckedIn      Boolean      @default(false)
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  visitCount       Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  store            Store        @relation(fields: [storeId], references: [id])
  gamePlayers      GamePlayer[]
  users            AppUser[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([storeId, isCheckedIn])
}

model AppUser {
  id                 String   @id @default(cuid())
  storeId            String
  playerId           String?
  role               UserRole
  email              String   @unique
  name               String
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  store              Store    @relation(fields: [storeId], references: [id])
  player             Player?  @relation(fields: [playerId], references: [id])

  @@index([storeId, role])
  @@index([playerId])
}

model Game {
  id             String          @id @default(cuid())
  storeId        String
  tableId        String
  tournamentId   String?
  status         GameStatus      @default(ACTIVE)
  category       GameCategory    @default(REGULAR)
  resultSource   ResultSource?
  resultPayload  Json?
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  store          Store           @relation(fields: [storeId], references: [id])
  table          MahjongTable    @relation(fields: [tableId], references: [id])
  tournament     Tournament?     @relation(fields: [tournamentId], references: [id])
  players        GamePlayer[]
  pointSnapshots PointSnapshot[]

  @@index([storeId, status, startedAt])
  @@index([storeId, category, status, startedAt])
  @@index([tournamentId])
  @@index([tableId, status])
}

model Tournament {
  id         String         @id @default(cuid())
  storeId    String
  name       String
  tableCount Int            @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  store      Store          @relation(fields: [storeId], references: [id])
  games      Game[]
  tables     MahjongTable[]

  @@unique([storeId, name])
  @@index([storeId, startsAt])
}

model GamePlayer {
  id            String   @id @default(cuid())
  gameId        String
  playerId      String
  seat          Int
  currentPoints Int      @default(25000)
  finalPoints   Int?
  rank          Int?
  score         Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  game          Game     @relation(fields: [gameId], references: [id])
  player        Player   @relation(fields: [playerId], references: [id])

  @@unique([gameId, playerId])
  @@unique([gameId, seat])
  @@index([playerId])
  @@index([rank])
}

model PointSnapshot {
  id        String       @id @default(cuid())
  tableId   String
  gameId    String?
  deviceId  String
  payload   Json
  createdAt DateTime     @default(now())
  table     MahjongTable @relation(fields: [tableId], references: [id])
  game      Game?        @relation(fields: [gameId], references: [id])

  @@index([tableId, createdAt])
  @@index([gameId])
}
